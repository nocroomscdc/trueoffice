import asyncio
import json
import websockets

from database import init_db, get_users, add_user


clients = {}


async def send_json(websocket, data):
    await websocket.send(json.dumps(data))


async def broadcast(data):
    if not clients:
        return

    message = json.dumps(data)

    await asyncio.gather(
        *(client.send(message) for client in clients),
        return_exceptions=True
    )


async def broadcast_users():
    online_users = list(dict.fromkeys(clients.values()))
    all_users = get_users()

    await broadcast({
        "type": "users",
        "users": online_users,
        "all_users": all_users
    })


async def handle(websocket):

    username = None

    try:

        async for raw_message in websocket:

            try:
                data = json.loads(raw_message)

            except json.JSONDecodeError:
                continue

            message_type = data.get("type")


            # =========================
            # JOIN
            # =========================

            if message_type == "join":

                username = str(
                    data.get("username", "Guest")
                ).strip()

                if not username:
                    username = "Guest"


                # Automatically save new login user
                add_user(username)


                clients[websocket] = username


                print(
                    "Connected:",
                    username,
                    websocket.remote_address
                )


                await send_json(
                    websocket,
                    {
                        "type": "system",
                        "message":
                            f"{username} joined TrueOffice"
                    }
                )


                await broadcast_users()


            # =========================
            # ADD USER
            # =========================

            elif message_type == "add_user":

                new_username = str(
                    data.get("username", "")
                ).strip()


                if not new_username:
                    await send_json(
                        websocket,
                        {
                            "type": "user_result",
                            "success": False,
                            "message":
                                "Username required"
                        }
                    )

                    continue


                if len(new_username) > 40:

                    await send_json(
                        websocket,
                        {
                            "type": "user_result",
                            "success": False,
                            "message":
                                "Username too long"
                        }
                    )

                    continue


                created = add_user(new_username)


                if created:

                    print(
                        "New user added:",
                        new_username
                    )

                    await send_json(
                        websocket,
                        {
                            "type": "user_result",
                            "success": True,
                            "username": new_username,
                            "message":
                                f"{new_username} added"
                        }
                    )

                    await broadcast_users()

                else:

                    await send_json(
                        websocket,
                        {
                            "type": "user_result",
                            "success": False,
                            "username": new_username,
                            "message":
                                f"{new_username} already exists"
                        }
                    )


            # =========================
            # MESSAGE
            # =========================

            elif message_type == "message":

                if websocket not in clients:
                    continue


                username = clients[websocket]


                text = str(
                    data.get("text", "")
                ).strip()


                if not text:
                    continue


                await broadcast(
                    {
                        "type": "message",
                        "username": username,
                        "text": text
                    }
                )


    except websockets.exceptions.ConnectionClosed:
        pass


    finally:

        if websocket in clients:

            username = clients.pop(websocket)

            print(
                "Disconnected:",
                username
            )

            await broadcast_users()


async def main():

    init_db()


    print(
        "Saved users:",
        get_users()
    )


    async with websockets.serve(
        handle,
        "0.0.0.0",
        9000
    ):

        print(
            "TrueOffice WebSocket Server "
            "Running on port 9000"
        )

        await asyncio.Future()


if __name__ == "__main__":
    asyncio.run(main())
