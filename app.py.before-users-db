from flask import Flask, render_template, send_from_directory
import os

app = Flask(__name__)


@app.route("/")
def home():
    return render_template("chat.html")


@app.route("/login")
def login():
    return send_from_directory("/opt/trueoffice", "login.html")


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
