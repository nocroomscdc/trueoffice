<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>TrueOffice Login</title>

<link rel="stylesheet" href="static/css/style.css">

<style>

.login{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
}

.card{

background:#1f2937;
padding:40px;
border-radius:15px;
width:350px;
text-align:center;

}

.card input{

width:90%;
padding:15px;
margin:15px;
border-radius:8px;
border:none;

}

.card button{

padding:15px 30px;
background:#2563eb;
color:white;
border:0;
border-radius:8px;

}

</style>

</head>

<body>

<div class="login">

<div class="card">

<h2>💬 TrueOffice</h2>

<p>Office Communication System</p>


<input id="username" placeholder="Enter your name">


<button onclick="login()">
Join Chat
</button>


</div>

</div>


<script>

function login(){

let name=document.getElementById("username").value;


if(name==""){
alert("Enter name");
return;
}


localStorage.setItem("username",name);


window.location="index.html";

}

</script>


</body>
</html>
