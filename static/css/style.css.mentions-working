*{
    box-sizing:border-box;
}

:root{
    --bg:#080b12;
    --panel:#0f141d;
    --panel2:#121925;
    --border:rgba(255,255,255,.08);
    --text:#f5f7fb;
    --muted:#8d98aa;
    --blue:#4f7cff;
    --blue2:#6d8fff;
    --bubble:#171f2d;
}

html,
body{
    margin:0;
    width:100%;
    height:100%;
    font-family:Inter,Segoe UI,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
}

button,
input{
    font:inherit;
}

button{
    cursor:pointer;
}

.app-shell{
    width:100%;
    height:100vh;
    display:flex;
    overflow:hidden;
    background:
        radial-gradient(circle at 80% 10%,rgba(79,124,255,.10),transparent 28%),
        radial-gradient(circle at 20% 90%,rgba(123,92,255,.07),transparent 25%),
        var(--bg);
}

/* SIDEBAR */

.sidebar{
    width:300px;
    min-width:300px;
    height:100%;
    display:flex;
    flex-direction:column;
    background:rgba(12,17,25,.96);
    border-right:1px solid var(--border);
}

.brand{
    height:82px;
    display:flex;
    align-items:center;
    gap:13px;
    padding:0 22px;
    border-bottom:1px solid var(--border);
}

.brand-logo{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:13px;
    background:linear-gradient(135deg,#4f7cff,#795cff);
    box-shadow:0 8px 25px rgba(79,124,255,.28);
    font-size:20px;
    font-weight:800;
}

.brand strong{
    display:block;
    font-size:17px;
    letter-spacing:.2px;
}

.brand span{
    display:block;
    margin-top:3px;
    color:var(--muted);
    font-size:11px;
}

.search-box{
    margin:18px 16px 10px;
    height:42px;
    display:flex;
    align-items:center;
    gap:9px;
    padding:0 13px;
    border:1px solid var(--border);
    border-radius:11px;
    background:#0a0f17;
    color:var(--muted);
}

.search-box span{
    font-size:21px;
}

.search-box input{
    width:100%;
    border:0;
    outline:0;
    background:transparent;
    color:white;
    font-size:13px;
}

.section-title{
    padding:18px 20px 9px;
    color:#697486;
    font-size:10px;
    font-weight:700;
    letter-spacing:1.3px;
}

.nav-item{
    margin:2px 10px;
    padding:12px;
    display:flex;
    gap:12px;
    align-items:center;
    border-radius:11px;
    color:#aab3c2;
}

.nav-item span{
    width:26px;
    text-align:center;
    font-size:18px;
}

.nav-item strong{
    display:block;
    font-size:13px;
    color:#d8deea;
}

.nav-item small{
    display:block;
    margin-top:3px;
    color:#697486;
    font-size:10px;
}

.nav-item.active{
    background:linear-gradient(90deg,rgba(79,124,255,.18),rgba(79,124,255,.06));
    border:1px solid rgba(79,124,255,.18);
}

.nav-item.active strong{
    color:white;
}

.users-title{
    display:flex;
    justify-content:space-between;
}

.users-title b{
    padding:3px 7px;
    border-radius:20px;
    background:#1c2533;
    color:#8490a4;
    font-size:9px;
}

.user-list{
    padding:0 10px;
}

.user{
    display:flex;
    align-items:center;
    gap:10px;
    padding:9px 10px;
    border-radius:10px;
}

.user:hover{
    background:rgba(255,255,255,.035);
}

.avatar{
    position:relative;
    flex-shrink:0;
    width:38px;
    height:38px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    color:white;
    font-weight:700;
    font-size:13px;
}

.purple{background:linear-gradient(135deg,#765cff,#a36dff);}
.blue{background:linear-gradient(135deg,#3978ff,#42b4ff);}
.green{background:linear-gradient(135deg,#17a673,#56d68d);}
.orange{background:linear-gradient(135deg,#ed8b31,#ffc05a);}

.user-info{
    flex:1;
    min-width:0;
}

.user-info strong{
    display:block;
    font-size:12px;
}

.user-info small{
    display:block;
    margin-top:3px;
    color:#687486;
    font-size:10px;
}

.online{
    display:inline-block;
    width:7px;
    height:7px;
    border-radius:50%;
    background:#31d98a;
    box-shadow:0 0 8px rgba(49,217,138,.6);
}

.sidebar-bottom{
    margin-top:auto;
    padding:15px;
    border-top:1px solid var(--border);
}

.profile{
    display:flex;
    align-items:center;
    gap:10px;
}

.profile-avatar{
    width:36px;
    height:36px;
    background:linear-gradient(135deg,#475569,#64748b);
}

.profile strong{
    display:block;
    max-width:150px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    font-size:12px;
}

.profile small{
    display:flex;
    align-items:center;
    gap:5px;
    margin-top:3px;
    color:#7d899b;
    font-size:10px;
}

.profile button{
    margin-left:auto;
    border:0;
    background:transparent;
    color:#7f8999;
    font-size:20px;
}

/* CHAT */

.chat-area{
    min-width:0;
    flex:1;
    height:100%;
    display:flex;
    flex-direction:column;
}

.chat-header{
    height:82px;
    flex-shrink:0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 28px;
    border-bottom:1px solid var(--border);
    background:rgba(11,15,22,.72);
    backdrop-filter:blur(15px);
}

.chat-title{
    display:flex;
    align-items:center;
    gap:13px;
}

.team-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    background:#17243c;
    font-size:18px;
}

.chat-title h2{
    margin:0;
    font-size:16px;
}

.chat-title p{
    margin:5px 0 0;
    color:#788496;
    font-size:10px;
}

.status-dot{
    display:inline-block;
    width:6px;
    height:6px;
    margin-right:5px;
    border-radius:50%;
    background:#31d98a;
}

.header-actions{
    display:flex;
    gap:7px;
}

.header-actions button{
    width:38px;
    height:38px;
    border:1px solid var(--border);
    border-radius:10px;
    background:#111823;
    color:#8f9bad;
    font-size:19px;
}

.header-actions button:hover{
    color:white;
    background:#182131;
}

/* MESSAGES */

.messages{
    flex:1;
    overflow-y:auto;
    padding:28px 7%;
    scrollbar-width:thin;
    scrollbar-color:#293447 transparent;
}

.date-divider{
    display:flex;
    align-items:center;
    gap:12px;
    margin:0 0 25px;
    color:#626d7e;
    font-size:10px;
}

.date-divider:before,
.date-divider:after{
    content:"";
    height:1px;
    flex:1;
    background:var(--border);
}

.msg-row{
    display:flex;
    align-items:flex-start;
    gap:11px;
    margin-bottom:22px;
    animation:messageIn .22s ease;
}

@keyframes messageIn{
    from{
        opacity:0;
        transform:translateY(5px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.message-content{
    max-width:min(650px,75%);
}

.message-meta{
    display:flex;
    align-items:center;
    gap:9px;
    margin:1px 0 6px 2px;
}

.message-meta strong{
    font-size:12px;
}

.message-meta span{
    color:#687486;
    font-size:10px;
}

.bubble{
    display:inline-block;
    padding:12px 15px;
    border:1px solid rgba(255,255,255,.055);
    border-radius:5px 15px 15px 15px;
    background:var(--bubble);
    color:#dce2eb;
    font-size:13px;
    line-height:1.55;
    box-shadow:0 7px 25px rgba(0,0,0,.12);
}

.mention{
    display:inline-block;
    margin-right:3px;
    color:#8faeff;
    font-weight:600;
}

/* FILE */

.file-card{
    width:280px;
    margin-top:8px;
    padding:11px;
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--border);
    border-radius:12px;
    background:#101824;
}

.file-icon{
    width:35px;
    height:35px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:9px;
    background:#18253a;
}

.file-card strong{
    display:block;
    font-size:11px;
}

.file-card small{
    display:block;
    margin-top:3px;
    color:#697486;
    font-size:9px;
}

.file-card button{
    margin-left:auto;
    border:0;
    background:transparent;
    color:#8190a5;
}

/* COMPOSER */

.composer-area{
    padding:13px 7% 16px;
    border-top:1px solid var(--border);
    background:rgba(10,14,21,.92);
}

.composer{
    min-height:56px;
    display:flex;
    align-items:center;
    gap:8px;
    padding:7px;
    border:1px solid #263143;
    border-radius:15px;
    background:#111823;
    box-shadow:0 12px 35px rgba(0,0,0,.22);
}

.composer:focus-within{
    border-color:rgba(79,124,255,.55);
    box-shadow:0 0 0 3px rgba(79,124,255,.08);
}

.composer input[type="text"],
.composer input:not([type]){
    flex:1;
}

#messageInput{
    min-width:0;
    height:42px;
    padding:0 8px;
    border:0;
    outline:0;
    background:transparent;
    color:#f4f6fa;
    font-size:13px;
}

#messageInput::placeholder{
    color:#697588;
}

.tool-btn,
.emoji-btn{
    width:40px;
    height:40px;
    flex-shrink:0;
    border:0;
    border-radius:10px;
    background:transparent;
    color:#7f8b9e;
    font-size:18px;
}

.tool-btn:hover,
.emoji-btn:hover{
    background:#1b2534;
    color:white;
}

.send-btn{
    height:42px;
    padding:0 16px;
    display:flex;
    align-items:center;
    gap:8px;
    border:0;
    border-radius:11px;
    background:linear-gradient(135deg,var(--blue),#6b5cff);
    color:white;
    font-size:12px;
    font-weight:700;
    box-shadow:0 8px 20px rgba(79,124,255,.2);
}

.send-btn:hover{
    transform:translateY(-1px);
}

.send-btn b{
    font-size:14px;
}

.composer-footer{
    display:flex;
    justify-content:space-between;
    padding:7px 4px 0;
    color:#596577;
    font-size:9px;
}

.composer-footer b{
    color:#7d8999;
}

/* SCROLLBAR */

.messages::-webkit-scrollbar{
    width:6px;
}

.messages::-webkit-scrollbar-thumb{
    border-radius:10px;
    background:#273244;
}

/* RESPONSIVE */

@media(max-width:800px){

    .sidebar{
        width:235px;
        min-width:235px;
    }

    .messages,
    .composer-area{
        padding-left:20px;
        padding-right:20px;
    }

}

@media(max-width:600px){

    .sidebar{
        display:none;
    }

    .chat-header{
        padding:0 15px;
    }

    .messages,
    .composer-area{
        padding-left:12px;
        padding-right:12px;
    }

    .composer-footer{
        display:none;
    }

    .send-btn span{
        display:none;
    }

    .send-btn{
        width:42px;
        justify-content:center;
        padding:0;
    }

    .message-content{
        max-width:85%;
    }
}

/* @MENTION SUGGESTIONS */

.composer {
    position: relative !important;
}

.mention-suggestions {
    position: fixed !important;
    left: 50% !important;
    bottom: 105px !important;
    margin-bottom: 10px !important;
    width: 280px !important;
    max-height: 240px !important;
    overflow-y: auto !important;
    background: #182131 !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-radius: 14px !important;
    padding: 6px !important;
    box-shadow: 0 18px 45px rgba(0,0,0,.45) !important;
    display: none;
    z-index: 99999 !important;
}

.mention-option {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 10px !important;
    border-radius: 10px !important;
    cursor: pointer !important;
}

.mention-option:hover {
    background: rgba(255,255,255,.08) !important;
}

.mention-option .mention-avatar {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    border-radius: 50% !important;
    display: grid !important;
    place-items: center !important;
    font-weight: 700 !important;
    background: #334155 !important;
}

.mention-option strong {
    display: block !important;
    font-size: 13px !important;
}

.mention-option small {
    display: block !important;
    color: #94a3b8 !important;
    font-size: 11px !important;
}

.mention {
    color: #60a5fa;
    font-weight: 700;
    background: rgba(59,130,246,.12);
    padding: 1px 4px;
    border-radius: 5px;
}
