body{
margin:0;
font-family:Arial;
background:#111827;
color:white;
}


.header{
height:60px;
background:#2563eb;
display:flex;
justify-content:space-between;
align-items:center;
padding:0 25px;
}


.container{

display:flex;
height:calc(100vh - 60px);

}


.users{

width:250px;
background:#1f2937;
padding:20px;

}


.users p{

background:#374151;
padding:12px;
border-radius:8px;

}


.chat{

flex:1;
display:flex;
flex-direction:column;

}


.messages{

flex:1;
padding:20px;
overflow:auto;

}


.msg{

background:#374151;
padding:12px;
margin-bottom:15px;
border-radius:12px;

}


.input{

display:flex;
padding:15px;
background:#1f2937;

}


input{

flex:1;
padding:15px;
border-radius:8px;
border:none;

}


button{

background:#2563eb;
color:white;
border:none;
padding:15px 25px;
margin-left:10px;
border-radius:8px;

}
